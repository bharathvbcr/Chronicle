{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/contract/enrich.schema.json",
  "title": "Chronicle Enrich Sidecar v1",
  "description": "brain/enrich/yyyy-MM.json — map of entry id to enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated", "entries"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated": {
      "type": "string",
      "minLength": 1
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["auto_tags", "summary_line", "entities"],
        "properties": {
          "auto_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "summary_line": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "kind": {
                      "type": "string",
                      "enum": ["person", "place", "project", "topic", "concept"]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
