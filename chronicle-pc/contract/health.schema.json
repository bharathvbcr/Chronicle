{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/contract/health.schema.json",
  "title": "Chronicle Health Month v1",
  "description": "health/yyyy/MM.json — monthly map of local date to imported sleep/steps",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "days"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "days": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\d{4}-\\d{2}-\\d{2}$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "sleep": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "duration_min", "stages"],
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ISO-8601 timestamp with offset"
                },
                "end": {
                  "type": "string",
                  "minLength": 1,
                  "description": "ISO-8601 timestamp with offset"
                },
                "duration_min": {
                  "type": "integer",
                  "minimum": 0
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["stage", "start", "end"],
                    "properties": {
                      "stage": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "string",
                        "minLength": 1
                      },
                      "end": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "steps": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Import origin, e.g. health_connect"
            }
          }
        }
      }
    }
  }
}
