{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronicle.local/contract/insight.schema.json",
  "title": "Chronicle Insight v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "date", "generated", "summary", "themes", "related_entries"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "mood_avg": {
      "type": ["number", "null"]
    },
    "themes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "connections": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      }
    },
    "related_entries": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Map of entry id → related entry ids"
    },
    "on_this_day": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Entry ids from ~a month/year back"
    },
    "time_capsules": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["entry_id"],
            "properties": {
              "entry_id": { "type": "string" },
              "due": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
